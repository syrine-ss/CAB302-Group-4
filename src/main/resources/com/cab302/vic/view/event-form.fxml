<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.cab302.vic.controller.EventFormController"
           styleClass="root">

    <VBox maxWidth="520" spacing="10" styleClass="auth-card">
        <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

        <Label fx:id="headingLabel" text="Create New Event" styleClass="title"/>

        <Label text="Title" styleClass="field-label"/>
        <TextField fx:id="titleField" promptText="Event title"/>

        <Label text="Description" styleClass="field-label"/>
        <TextArea fx:id="descriptionArea" promptText="What's the event about?" prefRowCount="3" wrapText="true"/>

        <HBox spacing="10">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Date" styleClass="field-label"/>
                <DatePicker fx:id="datePicker" maxWidth="Infinity"/>
            </VBox>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Time (HH:mm)" styleClass="field-label"/>
                <TextField fx:id="timeField" promptText="09:00"/>
            </VBox>
        </HBox>

        <Label text="Location" styleClass="field-label"/>
        <TextField fx:id="locationField" promptText="Where's it happening?"/>

        <Label text="Volunteers needed" styleClass="field-label"/>
        <Spinner fx:id="volunteersSpinner" editable="true" maxWidth="Infinity"/>

        <Label fx:id="messageLabel" wrapText="true"/>

        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Cancel" onAction="#onCancelClick" styleClass="secondary"/>
            <Button text="Save" onAction="#onSaveClick" defaultButton="true" styleClass="primary"/>
        </HBox>
    </VBox>
</StackPane>

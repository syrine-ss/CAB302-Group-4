<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.cab302.vic.controller.LoginController"
           styleClass="root">
    <VBox alignment="CENTER" spacing="14" maxWidth="360" styleClass="auth-card">
        <padding><Insets top="32" right="32" bottom="32" left="32"/></padding>

        <Label text="Volunteer Impact Coordinator" styleClass="title"/>
        <Label text="Sign in to continue" styleClass="subtitle"/>

        <TextField fx:id="usernameField" promptText="Username"/>
        <PasswordField fx:id="passwordField" promptText="Password"/>

        <Button text="Log In" onAction="#onLoginButtonClick" defaultButton="true"
                maxWidth="Infinity" styleClass="primary"/>

        <Hyperlink text="Don't have an account? Create one" onAction="#onRegisterLinkClick"/>

        <Label fx:id="messageLabel" wrapText="true"/>
    </VBox>
</StackPane>

<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="12"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.cab302.vic.controller.LoginController">
    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <Label text="Volunteer Impact Coordinator" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
    <Label text="Sign in to continue"/>

    <TextField fx:id="usernameField" promptText="Username" maxWidth="280"/>
    <PasswordField fx:id="passwordField" promptText="Password" maxWidth="280"/>

    <Button text="Log In" onAction="#onLoginButtonClick" defaultButton="true"/>
    <Hyperlink text="Create an account" onAction="#onRegisterLinkClick"/>

    <Label fx:id="messageLabel" style="-fx-text-fill: firebrick;"/>
</VBox>

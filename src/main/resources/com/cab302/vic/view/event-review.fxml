<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.cab302.vic.controller.EventReviewController"
            styleClass="root">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="top-bar">
            <Label fx:id="eventTitle" styleClass="brand"/>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="12">
            <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>

            <Label text="Volunteers" styleClass="section-heading"/>
            <Label text="Review volunteers sign-ups, attendance, and approve or deny hours." styleClass="subtitle"/>
            <ListView fx:id="signupsList" VBox.vgrow="ALWAYS"/>
            <Button fx:id="homeButton" text="Back" onAction="#onHomeClick" styleClass="primary"/>
        </VBox>
    </center>
</BorderPane>